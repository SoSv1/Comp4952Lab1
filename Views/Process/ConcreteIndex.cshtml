@model Process[]

@{
    ViewData["Title"] = "Concrete Process Page";
}
<h1>@ViewData["Title"]</h1>

<p>This is the @ViewData["Title"]</p>

<ul>
@foreach (var item in Model)
{  
    <li>
            <a class="nav-link text-white"
                asp-controller="Process" asp-action="ConcreteProcessDetails"
               asp-route-id="@item.Id">@item.ProcessName (ID: @item.Id)</a>
    </li>
}
</ul>